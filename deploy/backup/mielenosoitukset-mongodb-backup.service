[Unit]
Description=MongoDB backup for mielenosoitukset.fi
After=network-online.target
Wants=network-online.target
OnFailure=mielenosoitukset-backup-failed.service

[Service]
Type=oneshot
ExecStart=/var/www/mielenosoitukset_fi/deploy/backup/mongodb-backup.sh
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/mielenosoitukset
ReadOnlyPaths=/var/www/mielenosoitukset_fi
