#: mielenosoitukset_fi/templates/privacy.html:111
msgid "Yksityisyydensuoja ja GDPR"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:113
msgid ""
"Mielenosoitukset.fi sitoutuu suojelemaan käyttäjiensä yksityisyyttä ja "
"noudattamaan EU:n yleistä tietosuoja-asetusta (GDPR). Tämä osio kertoo, "
"kuinka keräämme, käytämme ja suojelemme henkilötietojasi."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:116
msgid "Mitä tietoja keräämme?"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:118
msgid ""
"kuten nimi ja sähköpostiosoite, jos olet yhteydessä meihin tai ilmoitat "
"tapahtumasi sivustolla."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:119
msgid "Käyttäjätoiminta"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:119
msgid "tiedot, kuten selaushistoria, klikkaukset ja käyttämäsi laitteen tiedot."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:120
msgid "Evästetiedot"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:120
msgid ""
"käytämme evästeitä parantaaksemme käyttökokemustasi ja kerätäksemme "
"analytiikkaa sivuston toiminnasta."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:124
msgid "Mihin käytämme tietoja?"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:125
msgid "Keräämiämme tietoja käytetään seuraaviin tarkoituksiin:"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:127
msgid "Tarjotaksemme ja ylläpitääksemme palveluamme."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:128
msgid "Parantaaksemme käyttökokemusta ja analysoidaksemme sivuston käyttöä."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:129
msgid "Yhteydenottoon, jos olet ilmoittanut tapahtuman tai pyytänyt lisätietoja."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:133
msgid "Kenelle jaamme tietoja?"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:134
msgid ""
"Emme jaa henkilötietojasi kolmansille osapuolille ilman suostumustasi, "
"paitsi seuraavissa tilanteissa:"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:136
msgid "Lain vaatimukset"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:136
msgid ""
"jos meidän on jaettava tietoja lain, viranomaispyynnön tai "
"oikeusprosessin perusteella."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:137
msgid "Palveluntarjoajat"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:137
msgid ""
"voimme käyttää kolmansia osapuolia teknisen tuen tai palvelun "
"toimittamiseen (esim. analytiikka), jotka ovat GDPR:n mukaisia."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:141
msgid "Kuinka kauan säilytämme tietojasi?"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:142
msgid ""
"Säilytämme henkilötietojasi vain niin kauan kuin on tarpeellista palvelun"
" tarjoamisen ja lakisääteisten vaatimusten täyttämiseksi."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:145
msgid "Sinun oikeutesi"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:146
msgid "GDPR:n mukaisesti sinulla on seuraavat oikeudet:"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:148
msgid "Oikeus nähdä"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:148
msgid "voit pyytää kopion kaikista sinua koskevista henkilötiedoista."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:149
msgid "Oikeus korjata"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:149
msgid "voit pyytää virheellisten tietojen oikaisua."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:150
msgid "Oikeus poistamiseen"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:150
msgid "voit pyytää tietojesi poistamista, jos tietoja ei enää tarvita."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:151
msgid "Oikeus rajoittaa käsittelyä"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:151
msgid "voit pyytää tietojesi käsittelyn rajoittamista tietyissä tilanteissa."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:152
msgid "Oikeus vastustaa"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:152
msgid "sinulla on oikeus vastustaa tietojesi käsittelyä tietyissä tilanteissa."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:156
msgid "Evästeiden käyttö"
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:157
msgid ""
"Käytämme evästeitä ja vastaavia tekniikoita analysoidaksemme verkkosivun "
"käyttöä ja parantaaksemme käyttökokemustasi. Voit hallita evästeasetuksia"
" selaimesi asetuksissa."
msgstr ""

#: mielenosoitukset_fi/templates/privacy.html:161
msgid ""
"Jos sinulla on kysyttävää tietosuojakäytännöstämme tai haluat käyttää "
"oikeuksiasi, voit ottaa yhteyttä sähköpostitse osoitteeseen"
msgstr ""

