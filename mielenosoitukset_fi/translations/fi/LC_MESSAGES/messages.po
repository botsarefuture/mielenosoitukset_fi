#: mielenosoitukset_fi/templates/info.html:98
msgid "Tietoa Mielenosoitukset.fi -sivustosta"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:101
msgid ""
"Mielenosoitukset.fi on sivusto, joka kokoaa yhteen kaikki Suomessa "
"järjestettävät mielenosoitukset ja yhteiskunnalliset tapahtumat. "
"Tavoitteenamme on tarjota kattava ja ajankohtainen tietolähde, jossa voit"
" seurata tulevia tapahtumia ja ilmoittaa omasta mielenosoituksestasi "
"helposti ja nopeasti."
msgstr ""

#: mielenosoitukset_fi/templates/info.html:105
msgid "Mikä on Mielenosoitukset.fi?"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:107
msgid ""
"Sivustomme toimii riippumattomana alustana, joka tarjoaa avoimen ja "
"neutraalin paikan kaikille mielenosoituksille ja protesteille. Meidän "
"tavoitteemme on auttaa kansalaisia löytämään tietoa, osallistumaan "
"aktiivisesti yhteiskunnallisiin tapahtumiin ja edistämään vapaata "
"mielipiteenilmaisua."
msgstr ""

#: mielenosoitukset_fi/templates/info.html:111
msgid "Kuinka ilmoitan mielenosoituksesta?"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:113
msgid "Voit ilmoittaa oman mielenosoituksesi täyttämällä"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:114
msgid "ilmoituslomakkeen"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:115
msgid ""
"Varmista, että kaikki tiedot ovat ajankohtaisia ja oikein, jotta muut "
"osallistujat saavat oikeaa ja täydellistä tietoa tapahtumastasi."
msgstr ""

#: mielenosoitukset_fi/templates/info.html:119
msgid "Kuka ylläpitää sivustoa?"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:121
msgid ""
"Mielenosoitukset.fi ylläpidetään riippumattomana projektina "
"vapaaehtoisten toimesta. Emme ole sidoksissa mihinkään poliittiseen "
"puolueeseen tai organisaatioon. Pyrimme tarjoamaan neutraalin alustan, "
"joka tukee monimuotoista ja vapaata mielipiteenilmaisua kaikille."
msgstr ""

#: mielenosoitukset_fi/templates/info.html:127
msgid ""
"Jos sinulla on kysyttävää, ehdotuksia tai haluat ottaa yhteyttä "
"ylläpitäjiin, voit lähettää sähköpostia osoitteeseen"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:129
msgid "tai täyttää"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:130
msgid "yhteydenottolomakkeen"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:134
msgid "Yksityisyys ja evästeet"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:136
msgid ""
"Käytämme evästeitä parantaaksemme käyttäjäkokemusta ja tarjotaksemme "
"sinulle paremman palvelun. Lisätietoa evästeiden käytöstä ja "
"tietosuojasta löydät"
msgstr ""

#: mielenosoitukset_fi/templates/info.html:137
msgid "yksityisyydensuojakäytännöstämme"
msgstr ""

